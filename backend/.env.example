# ==========================================
# BorKonya Backend Environment Configuration
# ==========================================

# Application
APP_NAME=BorKonya
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL / Supabase)
# In development, can use SQLite fallback for quick testing: sqlite:///./borkonya.db
# Or Supabase Postgres: postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./borkonya.db

# Supabase Auth & Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# JWT Security
JWT_SECRET=super_secret_jwt_signing_key_borkonya_community_2026_dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# External Gateways (Abstracted)
OTP_PROVIDER_KEY=mock_otp_provider_key
SMS_SENDER_ID=BORKON
PAYMENT_PROVIDER=MOCK
PAYMENT_PROVIDER_KEY=mock_payment_key
PAYMENT_PROVIDER_SECRET=mock_payment_secret
