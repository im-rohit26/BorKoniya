# ==========================================
# BorKonya Backend Environment Configuration
# ==========================================

# Application
APP_NAME=BorKonya
ENVIRONMENT=production
DEBUG=False
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=https://yourfrontenddomain.com,http://localhost:5173

# Database — PostgreSQL (REQUIRED)
# Format: postgresql+psycopg2://user:password@host:port/dbname
# Supabase example: postgresql+psycopg2://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/borkonya

# Supabase Auth & Storage (for file uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# JWT Security
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Email OTP (Gmail SMTP example)
# For Gmail: enable 2FA and generate an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_NAME=BorKonya
OTP_EXPIRY_MINUTES=10

# Payment Gateway
PAYMENT_PROVIDER=RAZORPAY
PAYMENT_PROVIDER_KEY=your_razorpay_key_id
PAYMENT_PROVIDER_SECRET=your_razorpay_key_secret

# WebRTC Voice & Video Calling (STUN / TURN / Redis)
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=turn:turn.yourdomain.com:3478?transport=udp,turn:turn.yourdomain.com:3478?transport=tcp,turns:turn.yourdomain.com:5349?transport=tcp
TURN_SHARED_SECRET=replace_with_coturn_static_auth_secret_for_short_lived_hmac_tokens
TURN_STATIC_USERNAME=
TURN_STATIC_CREDENTIAL=
TURN_CREDENTIAL_TTL_SECONDS=3600
CALL_RING_TIMEOUT_SECONDS=45
CALL_RATE_LIMIT_PER_MINUTE=10
REDIS_URL=

